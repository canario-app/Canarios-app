# Aplicación
APP_NAME=CanariApp
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

# Base de datos (PostgreSQL)
# Si estas en local, usa 'localhost' y para docker usa 'db'
DB_HOST=localhost
DB_PORT=5432
DB_NAME=canariapp_db
DB_USER=canariapp_db_user
DB_PASSWORD=canariapp_db_password

# Seguridad / JWT
JWT_SECRET=CanariApp_2026_Secure_Default_Key
JWT_EXPIRATION=7200